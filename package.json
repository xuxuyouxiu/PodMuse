{
  "name": "podcast-notes",
  "version": "1.7.11",
  "description": "播客笔记助手 - 小宇宙链接自动下载、AI提炼、写入Obsidian",
  "main": "dist-electron/main/index.js",
  "author": "podcast-notes contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuxuyouxiu/Podcast_notes"
  },
  "bugs": {
    "url": "https://github.com/xuxuyouxiu/Podcast_notes/issues"
  },
  "homepage": "https://github.com/xuxuyouxiu/Podcast_notes#readme",
  "keywords": [
    "podcast",
    "obsidian",
    "whisper",
    "deepseek",
    "xiaoyuzhoufm",
    "electron"
  ],
  "scripts": {
    "dev": "node \"node_modules/vite/bin/vite.js\"",
    "start": "node \"node_modules/electron/dist/electron.js\" .",
    "build": "node \"node_modules/vite/bin/vite.js\" build && node \"node_modules/electron-builder/out/cli/cli.js\" --win",
    "build:test": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-test-package.ps1",
    "build:setup": "node \"node_modules/vite/bin/vite.js\" build && node \"node_modules/electron-builder/out/cli/cli.js\" --win --config.directories.output=dist-exe",
    "deploy:test": "powershell -ExecutionPolicy Bypass -File .\\scripts\\deploy-test-build.ps1",
    "refresh:test": "npm run build:test && npm run deploy:test",
    "preview": "node \"node_modules/vite/bin/vite.js\" preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.1.8"
  }
}
